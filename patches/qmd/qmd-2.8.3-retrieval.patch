+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+import { mkdtemp, mkdir, rm, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { createStore, type QMDStore } from "../src/index.js";
+import { setDefaultLlamaCpp } from "../src/llm.js";
+import {
+  getCacheKey, hashContent, insertContent, insertDocument, insertEmbedding,
+  setCachedResult,
+} from "../src/store.js";
+
+// Keep indexing, retrieval, fusion, and cache reads/writes real. Only inference
+// and tokenization are replaced, so these tests need no downloaded models.
+describe("SDK model isolation, cache safety, and retrieval limits", () => {
+  let root: string;
+  let docs: string;
+  let store: QMDStore;
+
+  beforeEach(async () => {
+    root = await mkdtemp(join(tmpdir(), "qmd-sdk-regressions-"));
+    docs = join(root, "docs");
+    await mkdir(docs);
+    store = await createStore({
+      dbPath: join(root, "index.sqlite"),
+      config: { collections: { docs: { path: docs, pattern: "**/*.md" } } },
+    });
+  });
+
+  afterEach(async () => {
+    vi.restoreAllMocks();
+    setDefaultLlamaCpp(null);
+    await store.close();
+    await rm(root, { recursive: true, force: true });
+  });
+
+  async function addDocument(path: string, body: string) {
+    const hash = await hashContent(body);
+    const now = new Date().toISOString();
+    insertContent(store.internal.db, hash, body, now);
+    insertDocument(store.internal.db, "docs", path, path, hash, now, now);
+    return hash;
+  }
+
+  function fakeExpansion() {
+    return vi.spyOn(store.internal.llm!, "expandQuery").mockResolvedValue([
+      { type: "lex", text: "needle" },
+    ]);
+  }
+
+  test("embedding uses its store tokenizer even when the global model is unavailable", async () => {
+    setDefaultLlamaCpp({
+      async tokenize() { throw new Error("unrelated global model must not load"); },
+    } as any);
+    const llm = store.internal.llm!;
+    vi.spyOn(llm, "tokenize").mockImplementation(async text => Array.from(text, c => c.charCodeAt(0)) as any);
+    vi.spyOn(llm, "detokenize").mockImplementation(async tokens => String.fromCharCode(...tokens));
+    vi.spyOn(llm, "embed").mockResolvedValue({ embedding: [1, 0, 0], model: llm.embedModelName });
+    vi.spyOn(llm, "embedBatch").mockImplementation(async texts => texts.map(() => ({
+      embedding: [1, 0, 0], model: llm.embedModelName,
+    })));
+    await addDocument("long.md", "needle ".repeat(300));
+
+    const result = await store.embed();
+    expect(result.errors).toBe(0);
+    expect(result.chunksEmbedded).toBeGreaterThan(1);
+    expect(store.internal.getHashesNeedingEmbedding()).toBe(0);
+    expect(await store.searchVector("needle")).toHaveLength(1);
+  });
+
+  test("unavailable rerank contexts raise an error before any score is cached", async () => {
+    const llm = store.internal.llm!;
+    // Exercise the real LlamaCpp.rerank resource-failure branch without loading a model.
+    (llm as any)._ciMode = false;
+    vi.spyOn(llm as any, "ensureRerankContexts").mockResolvedValue([]);
+    await expect(llm.rerank("needle", [{ file: "a.md", text: "needle" }]))
+      .rejects.toThrow(/rerank.*unavailable/i);
+    await expect(store.internal.rerank("needle", [{ file: "a.md", text: "needle" }]))
+      .rejects.toThrow(/rerank.*unavailable/i);
+    expect(store.internal.db.prepare("SELECT COUNT(*) AS count FROM llm_cache").get()).toEqual({ count: 0 });
+  });
+
+  test("fallback responses cannot enter the score cache", async () => {
+    vi.spyOn(store.internal.llm!, "rerank").mockResolvedValue({
+      model: "fallback", results: [{ file: "a.md", score: 0.5, index: 0 }],
+    });
+    await expect(store.internal.rerank("needle", [{ file: "a.md", text: "needle" }]))
+      .rejects.toThrow(/rerank.*unavailable/i);
+    expect(store.internal.db.prepare("SELECT COUNT(*) AS count FROM llm_cache").get()).toEqual({ count: 0 });
+  });
+
+  test.each([undefined, "database tuning"])("old scores are ignored with intent %s and new scores stay warm", async intent => {
+    const llm = store.internal.llm!;
+    const query = "needle";
+    const doc = { file: "a.md", text: "needle document" };
+    setCachedResult(store.internal.db, getCacheKey("rerank", {
