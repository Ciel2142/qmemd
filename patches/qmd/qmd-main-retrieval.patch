+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+import { mkdtemp, mkdir, rm, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { createStore, type QMDStore } from "../src/index.js";
+import { setDefaultLlamaCpp } from "../src/llm.js";
+import { replaceDocumentMetadata } from "../src/metadata-store.js";
+import { METADATA_EXTRACTION_VERSION, type DocumentMetadata } from "../src/metadata.js";
+import {
+  getCacheKey, hashContent, insertContent, insertDocument, insertEmbedding,
+  setCachedResult,
+} from "../src/store.js";
+
+// Keep indexing, retrieval, fusion, and cache reads/writes real. Only inference
+// and tokenization are replaced, so these tests need no downloaded models.
+describe("SDK model isolation, cache safety, and retrieval limits", () => {
+  let root: string;
+  let docs: string;
+  let store: QMDStore;
+
+  beforeEach(async () => {
+    root = await mkdtemp(join(tmpdir(), "qmd-sdk-regressions-"));
+    docs = join(root, "docs");
+    await mkdir(docs);
+    store = await createStore({
+      dbPath: join(root, "index.sqlite"),
+      config: { collections: { docs: { path: docs, pattern: "**/*.md" } } },
+    });
+  });
+
+  afterEach(async () => {
+    vi.restoreAllMocks();
+    setDefaultLlamaCpp(null);
+    await store.close();
+    await rm(root, { recursive: true, force: true });
+  });
+
+  async function addDocument(path: string, body: string, metadata?: DocumentMetadata) {
+    const hash = await hashContent(body);
+    const now = new Date().toISOString();
+    insertContent(store.internal.db, hash, body, now);
+    const id = insertDocument(store.internal.db, "docs", path, path, hash, now, now);
+    if (metadata) replaceDocumentMetadata(store.internal.db, id, { metadata, extractionVersion: METADATA_EXTRACTION_VERSION });
+    return hash;
+  }
+
+  function fakeExpansion() {
+    return vi.spyOn(store.internal.llm!, "expandQuery").mockResolvedValue([
+      { type: "lex", text: "needle" },
+    ]);
+  }
+
+  test("embedding uses its store tokenizer even when the global model is unavailable", async () => {
+    setDefaultLlamaCpp({
+      async tokenize() { throw new Error("unrelated global model must not load"); },
+    } as any);
+    const llm = store.internal.llm!;
+    vi.spyOn(llm, "tokenize").mockImplementation(async text => Array.from(text, c => c.charCodeAt(0)) as any);
+    vi.spyOn(llm, "detokenize").mockImplementation(async tokens => String.fromCharCode(...tokens));
+    vi.spyOn(llm, "embed").mockResolvedValue({ embedding: [1, 0, 0], model: llm.embedModelName });
+    vi.spyOn(llm, "embedBatch").mockImplementation(async texts => texts.map(() => ({
+      embedding: [1, 0, 0], model: llm.embedModelName,
+    })));
+    await addDocument("long.md", "needle ".repeat(300));
+
+    const result = await store.embed();
+    expect(result.errors).toBe(0);
+    expect(result.chunksEmbedded).toBeGreaterThan(1);
+    expect(store.internal.getHashesNeedingEmbedding()).toBe(0);
+    expect(await store.searchVector("needle")).toHaveLength(1);
+  });
+
+  test("unavailable rerank contexts raise an error before any score is cached", async () => {
+    const llm = store.internal.llm!;
+    // Exercise the real LlamaCpp.rerank resource-failure branch without loading a model.
+    (llm as any)._ciMode = false;
+    vi.spyOn(llm as any, "ensureRerankContexts").mockResolvedValue([]);
+    await expect(llm.rerank("needle", [{ file: "a.md", text: "needle" }]))
+      .rejects.toThrow(/rerank.*unavailable/i);
+    await expect(store.internal.rerank("needle", [{ file: "a.md", text: "needle" }]))
+      .rejects.toThrow(/rerank.*unavailable/i);
+    expect(store.internal.db.prepare("SELECT COUNT(*) AS count FROM llm_cache").get()).toEqual({ count: 0 });
+  });
+
+  test("fallback responses cannot enter the score cache", async () => {
+    vi.spyOn(store.internal.llm!, "rerank").mockResolvedValue({
+      model: "fallback", results: [{ file: "a.md", score: 0.5, index: 0 }],
+    });
+    await expect(store.internal.rerank("needle", [{ file: "a.md", text: "needle" }]))
+      .rejects.toThrow(/rerank.*unavailable/i);
+    expect(store.internal.db.prepare("SELECT COUNT(*) AS count FROM llm_cache").get()).toEqual({ count: 0 });
+  });
+
+  test.each([undefined, "database tuning"])("old scores are ignored with intent %s and new scores stay warm", async intent => {
+    const llm = store.internal.llm!;
+    const query = "needle";
+    const doc = { file: "a.md", text: "needle document" };
+    setCachedResult(store.internal.db, getCacheKey("rerank", {
+      query: intent ? `${intent}\n\n${query}` : query, model: llm.rerankModelName, chunk: doc.text,
+    }), "0.5");
+    setCachedResult(store.internal.db, getCacheKey("rerank", {
+      query, file: doc.file, model: llm.rerankModelName, chunk: doc.text,
+    }), "0.99");
+    const inference = vi.spyOn(llm, "rerank").mockResolvedValue({
+      model: llm.rerankModelName, results: [{ file: doc.file, score: 0.8, index: 0 }],
+    });
+    expect(await store.internal.rerank(query, [doc], undefined, intent)).toEqual([{ file: doc.file, score: 0.8 }]);
+    inference.mockRejectedValue(new Error("warm cache must avoid inference"));
+    expect(await store.internal.rerank(query, [{ ...doc, file: "renamed.md" }], undefined, intent))
+      .toEqual([{ file: "renamed.md", score: 0.8 }]);
+  });
+
+  test("no-op SDK update preserves expansion and rerank caches", async () => {
+    await writeFile(join(docs, "a.md"), "needle document");
+    await store.update();
+    const expansion = fakeExpansion();
+    const llm = store.internal.llm!;
+    const ranking = vi.spyOn(llm, "rerank").mockResolvedValue({
+      model: llm.rerankModelName, results: [{ file: "a.md", score: 0.8, index: 0 }],
+    });
+    const doc = { file: "a.md", text: "needle document" };
+    const expanded = await store.expandQuery("find needle");
+    const ranked = await store.internal.rerank("needle", [doc]);
+    expect((await store.update()).unchanged).toBe(1);
+    expansion.mockRejectedValue(new Error("expansion cache lost"));
+    ranking.mockRejectedValue(new Error("rerank cache lost"));
+    expect(await store.expandQuery("find needle")).toEqual(expanded);
+    expect(await store.internal.rerank("needle", [doc])).toEqual(ranked);
+  });
+
+  test("changed corpus preserves reusable cache entries and scores changed text afresh", async () => {
+    await writeFile(join(docs, "a.md"), "needle original");
+    await store.update();
+    const expansion = fakeExpansion();
+    const llm = store.internal.llm!;
+    vi.spyOn(llm, "rerank").mockImplementation(async (_query, documents) => ({
+      model: llm.rerankModelName,
+      results: documents.map((doc, index) => ({ file: doc.file, index, score: doc.text.includes("changed") ? 0.9 : 0.8 })),
+    }));
+    await store.expandQuery("find needle");
+    await store.internal.rerank("needle", [{ file: "a.md", text: "needle original" }]);
+    await writeFile(join(docs, "a.md"), "needle changed");
+    expect((await store.update()).updated).toBe(1);
+    expansion.mockRejectedValue(new Error("corpus-independent expansion cache lost"));
+    expect(await store.expandQuery("find needle")).toEqual([{ type: "lex", query: "needle" }]);
+    const [doc] = await store.searchLex("needle");
+    expect(doc!.body).toBe("needle changed");
+    expect(await store.internal.rerank("needle", [{ file: doc!.filepath, text: doc!.body! }]))
+      .toEqual([{ file: doc!.filepath, score: 0.9 }]);
+  });
+
+  test.each(["original", "expansion", "structured"])("sourceLimit retrieves more than 20 lexical documents via %s", async mode => {
+    for (let i = 0; i < 35; i++) await addDocument(`${i}.md`, `needle document ${i}`);
+    fakeExpansion();
+    const query = mode === "structured" ? { queries: [{ type: "lex" as const, query: "needle" }] }
+      : { query: mode === "original" ? "needle" : "missingword" };
+    const options = { ...query, rerank: false, limit: 100, candidateLimit: 100 };
+    expect(await store.search(options)).toHaveLength(20);
+    expect(await store.search({ ...options, sourceLimit: 100 })).toHaveLength(35);
+    expect(await store.search({ ...options, sourceLimit: 100, candidateLimit: 7 })).toHaveLength(7);
+  });
+
+  test.each(["original", "vec", "hyde", "structured"])("sourceLimit retrieves more than 20 vector documents via %s", async mode => {
+    store.internal.ensureVecTable(3);
+    const llm = store.internal.llm!;
+    for (let i = 0; i < 35; i++) {
+      const hash = await addDocument(`${i}.md`, `document ${i}`);
+      insertEmbedding(store.internal.db, hash, 0, 0, new Float32Array([1, i / 100, 0]), llm.embedModelName, new Date().toISOString());
+    }
+    vi.spyOn(llm, "expandQuery").mockResolvedValue(mode === "vec" || mode === "hyde" ? [{ type: mode, text: "semantic needle" }] : []);
+    vi.spyOn(llm, "embedBatch").mockImplementation(async texts => texts.map(text =>
+      // Hide the original vector results for expansion cases.
+      text.includes("missingword") && mode !== "original" ? null
+        : { embedding: [1, 0, 0], model: llm.embedModelName },
+    ));
+    const query = mode === "structured" ? { queries: [{ type: "vec" as const, query: "semantic needle" }] } : { query: "missingword" };
+    expect(await store.search({ ...query, rerank: false, limit: 100, candidateLimit: 100, sourceLimit: 100 })).toHaveLength(35);
+  });
+
+  test.each([0, -1, 1.5, Infinity, NaN])("rejects invalid sourceLimit %s", async sourceLimit => {
+    await expect(store.search({ queries: [{ type: "lex", query: "needle" }], sourceLimit }))
+      .rejects.toThrow(/sourceLimit.*positive integer/);
+  });
+
+  test("sourceLimit 1 does not hide the runner-up from strong-signal detection", async () => {
+    for (let i = 0; i < 100; i++) await addDocument(`filler-${i}.md`, `unrelated background ${i}`);
+    await addDocument("first.md", "needle ".repeat(20));
+    await addDocument("second.md", "needle ".repeat(20));
+    await addDocument("expansion.md", "alternative");
+    vi.spyOn(store.internal.llm!, "expandQuery").mockResolvedValue([{ type: "lex", text: "alternative" }]);
+
+    const results = await store.search({ query: "needle", sourceLimit: 1, rerank: false });
+    expect(results).toHaveLength(2);
+    expect(results.some(result => result.file.endsWith("/expansion.md"))).toBe(true);
+  });
+
+  test.each(["original", "expansion", "structured", "original-vec", "vec", "hyde", "structured-vec"])("sourceLimit preserves metadata eligibility via %s", async mode => {
+    const vector = !["original", "expansion", "structured"].includes(mode);
+    const llm = store.internal.llm!;
+    if (vector) store.internal.ensureVecTable(3);
+    for (let i = 0; i < 70; i++) {
+      const hash = await addDocument(`${i}.md`, `needle document ${i}`, { status: i < 35 ? "published" : "draft" });
+      if (vector) insertEmbedding(store.internal.db, hash, 0, 0, new Float32Array([1, i / 100, 0]), llm.embedModelName, new Date().toISOString());
+    }
+    vi.spyOn(llm, "expandQuery").mockResolvedValue(mode === "vec" || mode === "hyde"
+      ? [{ type: mode, text: "semantic needle" }] : mode === "original-vec" ? [] : [{ type: "lex", text: "needle" }]);
+    vi.spyOn(llm, "embedBatch").mockImplementation(async texts => texts.map(text =>
+      text.includes("missingword") && mode !== "original-vec" ? null
+        : { embedding: [1, 0, 0], model: llm.embedModelName },
